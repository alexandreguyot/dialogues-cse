APP_NAME="Dialogues CSE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Vide : l'admin est sur /admin. Sinon elle répond sur <valeur>.<domaine de APP_URL>.
APP_SUBDOMAIN_URL=
TRUSTED_PROXIES=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dialogues_cse
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@dialogues-cse.fr"
MAIL_FROM_NAME="${APP_NAME}"

NOCAPTCHA_SITEKEY=
NOCAPTCHA_SECRET=
